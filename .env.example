# ==============================================================================
# InteriorFlow SaaS - Production Environment Configuration
# ==============================================================================

# Application Environment (production / staging / development)
ENV=production
DEBUG=False
PORT=8000
APP_BASE_URL=https://app.yourdomain.com

# PostgreSQL Production Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://interior_admin:SecretPostgresPassword2026!@localhost:5432/interior_saas

# Database Credentials (for docker-compose)
DB_PASSWORD=SecretPostgresPassword2026!

# Cryptographic JWT Secret (Generate with `openssl rand -hex 32`)
SECRET_KEY=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["https://app.yourdomain.com","https://quote.yourdomain.com"]

# WhatsApp Webhook Verification Token & Meta Cloud API Credentials
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=interior_webhook_verify_token_2026

# Storage / Redis
REDIS_URL=redis://localhost:6379/0
